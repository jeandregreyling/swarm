[Unit]
Description=Mondcraft Browser Minecraft Client Bridge
After=mondcraft-native.service network.target
Requires=mondcraft-native.service

[Service]
Type=simple
WorkingDirectory=/home/jd/swarm/mondcraft
ExecStart=/home/jd/.local/share/mondcraft/node-v22.23.3-linux-x64/bin/node /home/jd/swarm/mondcraft/client.cjs
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target