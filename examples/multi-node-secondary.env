# Seven's Swarm — Multi-Node Secondary Configuration
# This node registers to a primary and syncs proposals/skills/events.

# === Required ===
SWARM_ROOT=/home/you/swarm-secondary
SWARM_SECRET_KEY=change-me-secondary-secret

# === Environment ===
SWARM_ENV=production
SWARM_PORT=5051
SWARM_NODE_NAME=secondary

# === Federation ===
SWARM_FEDERATION_ENABLED=true
SWARM_NODE_URL=http://secondary-host:5051
SWARM_PRIMARY_URL=http://primary-host:5050
# API key obtained from primary during registration:
# SWARM_PRIMARY_API_KEY=...

# === Ollama ===
OLLAMA_HOST=http://localhost:11434

# === Security ===
SWARM_RATE_LIMIT=60
SWARM_AUTH_RATE_LIMIT=10
SWARM_CORS_ORIGINS=http://secondary-host:5051

# === Logging ===
SWARM_LOG_LEVEL=INFO
SWARM_LOG_DIR=logs
