# Seven's Swarm — Single Node Configuration
# Copy to .env at repo root and edit values

# === Required ===
SWARM_ROOT=/home/you/swarm
SWARM_SECRET_KEY=change-me-to-a-random-string

# === Environment ===
SWARM_ENV=production
SWARM_PORT=5050

# === Ollama ===
OLLAMA_HOST=http://localhost:11434

# === Security ===
SWARM_RATE_LIMIT=60
SWARM_AUTH_RATE_LIMIT=10
SWARM_MAX_CONTENT_LENGTH=1048576
SWARM_CORS_ORIGINS=http://localhost:5050

# === Logging ===
SWARM_LOG_LEVEL=INFO
SWARM_LOG_DIR=logs

# === Database ===
# Default: swarm_memory.db in SWARM_ROOT
# SWARM_DB_PATH=/home/you/swarm/swarm_memory.db

# === Optional Integrations ===
# TAVILY_API_KEY=tvly-...
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_CHAT_ID=...
