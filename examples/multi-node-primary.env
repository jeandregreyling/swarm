# Seven's Swarm — Multi-Node Primary Configuration
# This is the main/primary node that other nodes register to.

# === Required ===
SWARM_ROOT=/home/you/swarm
SWARM_SECRET_KEY=change-me-primary-secret

# === Environment ===
SWARM_ENV=production
SWARM_PORT=5050
SWARM_NODE_NAME=primary

# === Federation ===
SWARM_FEDERATION_ENABLED=true
SWARM_NODE_URL=http://primary-host:5050
# No SWARM_PRIMARY_URL needed — this IS the primary

# === Ollama ===
OLLAMA_HOST=http://localhost:11434

# === Security ===
SWARM_RATE_LIMIT=120
SWARM_AUTH_RATE_LIMIT=20
SWARM_CORS_ORIGINS=http://primary-host:5050,http://secondary-host:5051

# === Logging ===
SWARM_LOG_LEVEL=INFO
SWARM_LOG_DIR=logs
