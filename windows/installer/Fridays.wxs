<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fridays.wxs - WiX v4 installer authoring for Fridays (Seven's Swarm).

  Pipeline:
    1. windows\build.bat          -> windows\dist\Fridays\        (PyInstaller portable)
    2. wix harvest dir            -> windows\installer\Files.wxs  (auto component list)
    3. wix build                  -> windows\installer\Fridays.msi

  Install scope: per-user (no admin prompt). User data stays in
  %LOCALAPPDATA%\Fridays - launcher already handles this.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Fridays"
           Manufacturer="Seven's Swarm"
           Version="0.1.0"
           UpgradeCode="9F3C8D2E-1AB4-4D7F-B6E1-3C7A4E5F8901"
           Scope="perUser"
           Compressed="yes"
           InstallerVersion="500">

    <SummaryInformation Description="Fridays - Seven's Swarm local desktop app" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Fridays is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Install location: %LOCALAPPDATA%\Programs\Fridays\ (per-user, no admin) -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Fridays" />
      </Directory>
    </StandardDirectory>

    <!-- Start Menu shortcut -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Fridays" />
    </StandardDirectory>

    <!-- Desktop shortcut (optional - on by default; user can toggle in UI) -->
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="Fridays" Level="1">
      <!-- All harvested files (generated by `wix harvest dir`) -->
      <ComponentGroupRef Id="HarvestedFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="RegistryEntries" />
    </Feature>

    <!-- Shortcuts component -->
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="C5E1F2A3-4B5C-6D7E-8F90-A1B2C3D4E5F6">
        <Shortcut Id="StartMenuShortcut"
                  Name="Fridays"
                  Description="Seven's Swarm - local desktop app"
                  Target="[INSTALLFOLDER]Fridays.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="FridaysIcon.exe" />
        <RemoveFolder Id="RemoveAppProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\Sevens Swarm\Fridays"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="A1B2C3D4-E5F6-4789-89AB-CDEF01234567">
        <Shortcut Id="DesktopShortcut"
                  Name="Fridays"
                  Description="Seven's Swarm - local desktop app"
                  Target="[INSTALLFOLDER]Fridays.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="FridaysIcon.exe" />
        <RegistryValue Root="HKCU"
                       Key="Software\Sevens Swarm\Fridays"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Add/Remove Programs entry pin -->
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="RegistryEntries" Guid="B2C3D4E5-F6A7-4890-9ABC-DEF012345678">
        <RegistryValue Root="HKCU"
                       Key="Software\Sevens Swarm\Fridays"
                       Name="InstallPath"
                       Type="string"
                       Value="[INSTALLFOLDER]"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Icon shown in Add/Remove Programs and shortcuts -->
    <Icon Id="FridaysIcon.exe" SourceFile="$(var.SourceDir)\Fridays.exe" />
    <Property Id="ARPPRODUCTICON" Value="FridaysIcon.exe" />
    <Property Id="ARPHELPLINK" Value="https://github.com/sevens-swarm/fridays" />

    <!-- Minimal UI: license-less wizard with progress + finish-and-launch -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UIRef Id="WixUI_ErrorProgressText" />

    <!-- Launch app on finish (unchecked by default) -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Fridays now" />
    <Property Id="WixShellExecTarget" Value="[INSTALLFOLDER]Fridays.exe" />
    <CustomAction Id="LaunchApplication"
                  BinaryRef="Wix4UtilCA_X86"
                  DllEntry="WixShellExec"
                  Impersonate="yes" />

  </Package>
</Wix>
