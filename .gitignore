# PACKET-02/08 — file-per-record store, materialised from DB
runtime/records/
runtime/attachments/

# Tauri desktop build artifacts (huge; rebuildable)
desktop/src-tauri/target/

# 2026-05-02 (S-2838647C35) — runtime/auto-generated artifacts that
# regenerate on every boot/test run and don't belong in git history.
# Vortex was sweeping these into commits.
fridays/thinking_tree_log.json
runtime/seven/heartbeat.json
runtime/seven/ledger.offset
runtime/backups/log.jsonl
sandpits/shared/CURRENT_FOCUS.md
sandpits/shared/STALE_PROPOSALS.md
sandpits/shared/media_center_state.json
sandpits/studio/DISPATCHED_WORK.md
# 2026-05-02 (S-8C778B6AE7) — SYSTEM_INDEX.md / SYSTEM_LANDSCAPE.json
# are GENERATED by scripts/generate_system_index.py and
# scripts/generate_landscape_json.py. They are *runtime artifacts*,
# not source. Re-generate locally; do not commit them.
swarm_docs/SYSTEM_INDEX.md
swarm_docs/SYSTEM_LANDSCAPE.json
# 2026-05-02 (S-76A243907A) — Media Center / Studio media outputs.
# wav, png, avi, mp4, json artifacts under artifacts/ are *generated*
# from prompts at runtime and frequently exceed 1MB. Tracking them
# bloats history. The whole artifacts/ tree is rebuildable; check in
# specific assets only with `git add -f <path>` and a clear reason.
artifacts/
artifacts/media_center/
# Sandpit per-agent session logs (rolling, regenerated each run).
sandpits/*/session_*.log

.swarm/
