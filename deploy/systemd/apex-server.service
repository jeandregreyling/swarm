# APEX (gpt-oss:20B) on the RX 6800 via the Vulkan llama-server.
# Install: sudo cp apex-server.service /etc/systemd/system/ && sudo systemctl enable --now apex-server
# Do not run alongside apex-server-user.service (both bind :8080).
# The alias is passed via LLAMA_ARG_ALIAS, not --alias, so the Swarm llama pool
# (core/seven_llm/llama_server.py _foreign_servers) never adopts or reaps it.
[Unit]
Description=APEX gpt-oss:20B Vulkan llama-server (0.0.0.0:8080)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=jd
Environment=LLAMA_ARG_ALIAS=gpt-oss:20B
ExecStart=/home/jd/llama.cpp/build-vulkan/bin/llama-server \
    -m /mnt/archive/models/blobs/sha256-8ecb5d4ad6172c63f9cbf1a07a04e525985a8a11a6e516da02b674c4010de716 \
    --host 0.0.0.0 --port 8080 --ctx-size 8192 --parallel 1 \
    --jinja --chat-template-file /home/jd/llama.cpp/models/templates/openai-gpt-oss-120b.jinja \
    --no-webui
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
