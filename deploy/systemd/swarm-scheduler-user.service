[Unit]
Description=Seven's Swarm Fridays Scheduler (user)
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/seven/swarm
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/seven/swarm/fridays/scheduler_daemon.py --interval-seconds 60 --task-timeout-seconds 600
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
