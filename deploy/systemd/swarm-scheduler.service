[Unit]
Description=Seven's Swarm Fridays Scheduler
After=network.target ollama.service

[Service]
Type=simple
User=seven
WorkingDirectory=/home/seven/swarm
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/seven/swarm/fridays/scheduler_daemon.py --interval-seconds 60
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
