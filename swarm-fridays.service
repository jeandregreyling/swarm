[Unit]
Description=Seven's Swarm Fridays Orchestrator
After=network.target swarm-terminal.service

[Service]
Type=simple
User=seven
WorkingDirectory=/home/seven/swarm
ExecStart=/usr/bin/python3 /home/seven/swarm/fridays/orchestrator.py
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=-/home/seven/swarm/.env.agents

[Install]
WantedBy=multi-user.target
