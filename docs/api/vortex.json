{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vortex (Time Machine) Service API Contract",
  "description": "Workflow history, verified full-memory backups, offline recovery previews, timeline and sessions. Domain: Vortex.",
  "version": "1.1.0",
  "base_path": "/api/time",
  "auth": "session cookie",
  "endpoints": [
    {
      "method": "GET",
      "path": "/api/time/timeline",
      "description": "Get time events timeline.",
      "query_params": {"limit": {"type": "integer", "default": 50}}
    },
    {
      "method": "GET",
      "path": "/api/time/sessions",
      "description": "List time wizard sessions."
    },
    {
      "method": "GET",
      "path": "/api/time/checkpoint/{name}",
      "description": "Get a specific checkpoint by name."
    },
    {
      "method": "GET",
      "path": "/api/time/checkpoints",
      "description": "List all checkpoints."
    },
    {
      "method": "POST",
      "path": "/api/time/checkpoints",
      "description": "Create a manual checkpoint with a verified full SQLite memory backup. Automatic workflow checkpoints do not include full backups. Backups expire after 30 days; source files are not committed or restored.",
      "request": {
        "type": "object",
        "properties": {
          "label": {"type": "string"},
          "agent": {"type": "string"},
          "description": {"type": "string"}
        },
        "required": []
      }
    },
    {
      "method": "POST",
      "path": "/api/time/restore",
      "description": "Preview workflow drift and retained memory backup metadata. dry_run defaults to true. Online apply is disabled (409 after approval gating): recover with python -m core.vortex_backup restore MANIFEST --output NEW_DATABASE, then verify before an offline database switch.",
      "request": {
        "type": "object",
        "properties": {
          "checkpoint_name": {"type": "string"},
          "dry_run": {"type": "boolean", "default": true},
          "actor": {"type": "string"}
        },
        "required": ["checkpoint_name"]
      }
    },
    {
      "method": "GET",
      "path": "/api/time/stats/{agent}",
      "description": "Get time machine stats for an agent."
    },
    {
      "method": "POST",
      "path": "/api/time/bootstrap",
      "description": "Bootstrap time machine tables."
    },
    {
      "method": "POST",
      "path": "/api/time/log-decision",
      "description": "Log a decision to the time machine."
    },
    {
      "method": "GET",
      "path": "/api/time/decision-history/{decision_id}",
      "description": "Get decision history chain."
    }
  ]
}
