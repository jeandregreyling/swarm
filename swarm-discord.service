[Unit]
Description=Seven's Swarm — Fridays Discord Bot
After=network.target ollama.service swarm-prewarm.service swarm-listener.service

[Service]
Type=simple
User=seven
WorkingDirectory=/home/seven/swarm
ExecStart=/usr/bin/python3 /home/seven/swarm/fridays/discord_bot.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
