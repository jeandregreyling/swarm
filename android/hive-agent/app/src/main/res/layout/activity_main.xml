<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_main.xml — Hive Agent welcome screen.
  Anatomy:
    [header gradient + hex badge + name + tagline]
    [status pill: dot + state text]
    [card: leader URL + node id]
    [primary connect button + small stop button]
    [hint footer: how to find the leader URL]
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/brand_ink">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- ── Header ─────────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_header_gradient"
            android:paddingTop="48dp"
            android:paddingBottom="32dp"
            android:paddingHorizontal="24dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_hex_badge"
                android:contentDescription="@string/header_title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/header_title"
                android:textColor="@color/brand_text"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/header_tagline"
                android:textColor="@color/brand_text_dim"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <!-- ── Status pill ────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/status_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="-14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_status_pill"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp">

            <View
                android:id="@+id/status_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/status_dot" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/status_idle"
                android:textColor="@color/brand_text"
                android:textSize="12sp"
                android:textIsSelectable="true" />
        </LinearLayout>

        <!-- ── Form card ──────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_leader"
                android:textColor="@color/brand_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp"
                android:text="@string/label_leader_hint"
                android:textColor="@color/brand_text_dim"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/field_leader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_field"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:textColor="@color/brand_text"
                android:textColorHint="@color/brand_text_dim"
                android:textSize="14sp"
                android:hint="@string/hint_leader"
                android:inputType="textUri"
                android:singleLine="true"
                android:imeOptions="actionNext"
                android:autofillHints="none"
                android:importantForAutofill="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/label_node_id"
                android:textColor="@color/brand_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp"
                android:text="@string/label_node_id_hint"
                android:textColor="@color/brand_text_dim"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/field_node_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_field"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:textColor="@color/brand_text"
                android:textColorHint="@color/brand_text_dim"
                android:textSize="14sp"
                android:hint="@string/hint_node_id"
                android:inputType="text"
                android:singleLine="true"
                android:imeOptions="actionDone"
                android:autofillHints="none"
                android:importantForAutofill="no" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_connect"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="22dp"
                android:text="@string/btn_connect"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:backgroundTint="@color/brand_amber"
                android:textColor="@color/brand_ink"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_stop"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/btn_stop"
                android:textColor="@color/brand_text_dim"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- ── Footer hint ───────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/footer_hint"
            android:textColor="@color/brand_text_dim"
            android:textSize="11sp"
            android:lineSpacingExtra="2dp" />

    </LinearLayout>
</ScrollView>
