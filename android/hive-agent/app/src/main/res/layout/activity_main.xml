<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hive_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/brand_ink">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/header_title"
                android:textColor="@color/brand_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/status_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/status_dot" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/status_idle"
                android:textColor="@color/brand_text_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chat_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="14dp">

            <TextView
                android:id="@+id/model_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/model_summary_empty"
                android:textColor="@color/brand_text_dim"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/model_spinner"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_field"
                    android:paddingHorizontal="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_models"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="120dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="8dp"
                    android:text="@string/btn_models_short"
                    android:textAllCaps="false"
                    android:textColor="@color/brand_text"
                    app:strokeColor="@color/brand_border"
                    app:cornerRadius="6dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/chat_response"
                android:layout_width="match_parent"
                android:layout_height="430dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_field"
                android:gravity="bottom|start"
                android:padding="14dp"
                android:text="@string/chat_response_empty"
                android:textColor="@color/brand_text"
                android:textSize="14sp"
                android:textIsSelectable="true"
                android:lineSpacingExtra="3dp" />

            <EditText
                android:id="@+id/chat_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_field"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:textColor="@color/brand_text"
                android:textColorHint="@color/brand_text_dim"
                android:textSize="15sp"
                android:hint="@string/hint_chat"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="2"
                android:maxLines="4"
                android:imeOptions="actionSend"
                android:importantForAutofill="no" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_send_chat"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:text="@string/btn_send_chat"
                android:textAllCaps="false"
                android:backgroundTint="@color/brand_amber"
                android:textColor="@color/brand_ink"
                app:cornerRadius="6dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText android:id="@+id/field_leader" android:layout_width="1dp" android:layout_height="1dp" />
            <EditText android:id="@+id/field_node_id" android:layout_width="1dp" android:layout_height="1dp" />
            <TextView android:id="@+id/runtime_summary" android:layout_width="1dp" android:layout_height="1dp" />
            <TextView android:id="@+id/farm_summary" android:layout_width="1dp" android:layout_height="1dp" />
            <TextView android:id="@+id/chat_output_label" android:layout_width="1dp" android:layout_height="1dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_connect" android:layout_width="1dp" android:layout_height="1dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_stop" android:layout_width="1dp" android:layout_height="1dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_refresh" android:layout_width="1dp" android:layout_height="1dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_gpu_proof" android:layout_width="1dp" android:layout_height="1dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_run_chat_proof" android:layout_width="1dp" android:layout_height="1dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
