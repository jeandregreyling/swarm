<?xml version="1.0" encoding="utf-8"?>
<!--
  bg_field.xml — dark input pill. Slightly lighter than the card so
  fields read as clearly editable surfaces.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/brand_ink_field" />
    <stroke android:width="1dp" android:color="@color/brand_border" />
    <corners android:radius="10dp" />
</shape>
