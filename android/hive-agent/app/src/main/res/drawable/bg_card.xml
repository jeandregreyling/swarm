<?xml version="1.0" encoding="utf-8"?>
<!--
  bg_card.xml — rounded surface with subtle border. Used everywhere a
  card-shaped container is needed; keeps corner radius consistent.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/brand_ink_card" />
    <stroke android:width="1dp" android:color="@color/brand_border" />
    <corners android:radius="14dp" />
</shape>
