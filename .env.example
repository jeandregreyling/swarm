# Fridays / Swarm local configuration template.
#
# Copy to `.env.agents` or set these variables in your service environment.
# Do not put real keys in Git.

# Local agent/API auth
AGENT_API_KEY=replace-with-local-random-secret

# Optional online model/provider keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GITHUB_TOKEN=
XAI_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
OLLAMA_API_KEY=
HF_API_TOKEN=
HUGGINGFACE_API_TOKEN=

# Bot integrations
TELEGRAM_TOKEN=
DISCORD_TOKEN=

# Gmail / Google integrations
GMAIL_PASSWORD=
GMAIL_API_KEY=
GMAIL_TOKEN=

# Runtime paths and stage selection
SWARM_ROOT=/home/seven/swarm
SWARM_UAT_ROOT=/home/seven/swarm-uat
SWARM_DEV_ROOT=/home/seven/swarm-dev
SWARM_ENV=prod
PORT=5050

# Local database overrides
SWARM_DB_PATH=/home/seven/swarm/swarm_memory.db
SWARM_MEMORY_DB=/home/seven/swarm/swarm_memory.db

# Runtime guardrails
ALM_REQUIRE_APPROVALS=1
SWARM_CHAT_HANDOFF_DEADLINE_SECONDS=2000
SWARM_VORTEX_GIT_HEARTBEAT=0

# Hive / node options
SWARM_HIVE_TOKENS=/home/seven/swarm/swarm_hive_tokens.jsonl
SWARM_HIVE_REQUIRE_TOKEN=0
SWARM_HIVE_DISABLE_SELF_SAMPLER=0

# Voice/runtime tools
PIPER_BIN=/home/seven/swarm/.venv/bin/piper
PIPER_VOICES_DIR=/home/seven/swarm/models/piper
PIPER_DEFAULT_VOICE=en_GB-alba-medium
WHISPER_MODEL=base.en
